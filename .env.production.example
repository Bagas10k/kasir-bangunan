# Deployment template only; not loaded by the running Laravel preview.
# Provision a dedicated kasir database/user before filling the blank credentials.
APP_NAME="Kasir Bangunan"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://www.jajandigital.web.id/kasir-bangunan

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kasir_bangunan_prod
DB_USERNAME=
DB_PASSWORD=
# Dedicated loopback Laravel HTTP listener; never reuse PBJ or test preview ports.
KASIR_UPSTREAM_URL=

SESSION_DRIVER=database
SESSION_COOKIE=kasir_bangunan_session
SESSION_PATH=/kasir-bangunan
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_LEVEL=warning
CACHE_STORE=database
QUEUE_CONNECTION=database
